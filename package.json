{
  "name": "jsonresume-theme-remarkable",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A JSON Resume theme: a clean, serif, A4 print-ready CV.",
  "keywords": [
    "jsonresume",
    "jsonresume-theme",
    "resume",
    "cv"
  ],
  "exports": "./lib/index.js",
  "main": "./lib/index.js",
  "files": [
    "lib"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:theme": "vite build -c vite.theme.config.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "preview": "vite preview",
    "pdf": "pnpm build && node scripts/pdf.ts",
    "prepack": "pnpm build:theme"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "playwright-core": "^1.65.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.27.0"
}
